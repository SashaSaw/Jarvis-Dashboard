{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://100.87.235.73:3147/api/hooks -H 'Content-Type: application/json' -d '{\"event\":\"SessionStart\",\"session_id\":\"'\"$CLAUDE_SESSION_ID\"'\",\"timestamp\":\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"summary\":\"New Claude Code session started\",\"project\":\"'\"$(basename $(pwd))\"'\"}' > /dev/null 2>&1 &"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://100.87.235.73:3147/api/hooks -H 'Content-Type: application/json' -d '{\"event\":\"SessionEnd\",\"session_id\":\"'\"$CLAUDE_SESSION_ID\"'\",\"timestamp\":\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"summary\":\"Claude Code session ended\",\"project\":\"'\"$(basename $(pwd))\"'\"}' > /dev/null 2>&1 &"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://100.87.235.73:3147/api/hooks -H 'Content-Type: application/json' -d '{\"event\":\"TaskCompleted\",\"session_id\":\"'\"$CLAUDE_SESSION_ID\"'\",\"timestamp\":\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"summary\":\"Task completed\",\"project\":\"'\"$(basename $(pwd))\"'\"}' > /dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://100.87.235.73:3147/api/hooks -H 'Content-Type: application/json' -d '{\"event\":\"PostToolUse\",\"session_id\":\"'\"$CLAUDE_SESSION_ID\"'\",\"timestamp\":\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"summary\":\"Tool used: '\"$CLAUDE_TOOL_NAME\"'\",\"project\":\"'\"$(basename $(pwd))\"'\",\"metadata\":{\"tool\":\"'\"$CLAUDE_TOOL_NAME\"'\"}}' > /dev/null 2>&1 &"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://100.87.235.73:3147/api/hooks -H 'Content-Type: application/json' -d '{\"event\":\"SubagentStart\",\"session_id\":\"'\"$CLAUDE_SESSION_ID\"'\",\"timestamp\":\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"summary\":\"Sub-agent spawned\",\"project\":\"'\"$(basename $(pwd))\"'\"}' > /dev/null 2>&1 &"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://100.87.235.73:3147/api/hooks -H 'Content-Type: application/json' -d '{\"event\":\"SubagentStop\",\"session_id\":\"'\"$CLAUDE_SESSION_ID\"'\",\"timestamp\":\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"summary\":\"Sub-agent finished\",\"project\":\"'\"$(basename $(pwd))\"'\"}' > /dev/null 2>&1 &"
          }
        ]
      }
    ]
  }
}
